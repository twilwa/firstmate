{
  "schema": "firstmate-pr-review-policy.v1",
  "require_reviewed_head_handoff": false,
  "ledger_directory": "pr-review-ledger",
  "checkpoint_seconds": 600,
  "pending_retry_backoff_seconds": [300, 600, 1200, 1800],
  "high_stakes": {
    "no_mistakes_model": "claude-opus-5-5",
    "independent_agent_reviews": 0
  },
  "broad_change": {
    "files": 20,
    "changed_lines": 800
  },
  "low_stakes": {
    "files": 8,
    "changed_lines": 400
  },
  "reviewer_check_name_patterns": [
    "codex",
    "sourcery",
    "sentry",
    "coderabbit",
    "review"
  ]
}
