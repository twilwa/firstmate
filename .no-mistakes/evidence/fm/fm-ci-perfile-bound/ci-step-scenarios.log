tests-portable-parallel-1: timeout-minutes=50 step='Run portable parallel shard 1'
  run: set -eu
       mkdir -p "$RUNNER_TEMP/fm-test"
       bin/fm-test-run.sh --lane portable-parallel-1 \
         --per-script-timeout-secs 1500 \
         --fail-on-gate-skip 'Pi extension typecheck prerequisite not found' \
         --json "$RUNNER_TEMP/fm-test/fm-test-timing-portable-parallel-1.json"
       
tests-portable-parallel-2: timeout-minutes=50 step='Run portable parallel shard 2'
  run: set -eu
       mkdir -p "$RUNNER_TEMP/fm-test"
       bin/fm-test-run.sh --lane portable-parallel-2 \
         --per-script-timeout-secs 1500 \
         --json "$RUNNER_TEMP/fm-test/fm-test-timing-portable-parallel-2.json"
       
tests-portable-serial: timeout-minutes=50 step='Run portable serial shard ${{ matrix.shard }}'
  run: set -eu
       mkdir -p "$RUNNER_TEMP/fm-test"
       bin/fm-test-run.sh --lane "$FM_SERIAL_LANE" \
         --per-script-timeout-secs 1500 \
         --fail-on-gate-skip 'Pi extension typecheck prerequisite not found' \
         --json "$RUNNER_TEMP/fm-test/fm-test-timing-portable-serial-${FM_SERIAL_SHARD}.json"
       

