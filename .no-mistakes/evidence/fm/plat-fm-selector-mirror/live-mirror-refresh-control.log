===== with-mirror
backend = "beads"
[beads]
binary = "br"
path = ".beads"
prefix = "lab"
mirror = "data/backlog.md"
mirror_archive = "data/done-archive.md"
add q-1 exit=0
done d-1 exit=0
--- data/backlog.md:
    # Backlog
    
    <!-- Generated by tasks-axi from beads; read-only. Do not edit. -->
    
